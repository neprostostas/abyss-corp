{
  "name": "abyss-corp",
  "version": "0.0.0",
  "description": "Abyss Corp - account-based underwater tycoon",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.functions.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neprostostas/abyss-corp.git"
  },
  "keywords": [],
  "type": "module",
  "bugs": {
    "url": "https://github.com/neprostostas/abyss-corp/issues"
  },
  "homepage": "https://github.com/neprostostas/abyss-corp#readme",
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  },
  "private": true,
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}
